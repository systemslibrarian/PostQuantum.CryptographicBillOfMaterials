<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML doc. Docs are required on shipped public API but we don't
         block the build while the surface is still being filled in. Re-enable as error in CI. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Fallback version for local builds and `workflow_dispatch` runs. Releases do NOT use this:
         release.yml derives the version from the pushed tag and overrides it with `-p:Version=`. Keep this
         at or ahead of the last published version, or `dotnet-cbom version` reports a stale number — it
         reads its own assembly's informational version, which is stamped from here. -->
    <Version>1.2.0</Version>

    <!-- Package identity (shared) -->
    <Authors>systemslibrarian</Authors>
    <Company>PostQuantum</Company>
    <Product>PostQuantum.CryptographicBillOfMaterials</Product>
    <PackageProjectUrl>https://github.com/systemslibrarian/PostQuantum.CryptographicBillOfMaterials</PackageProjectUrl>
    <RepositoryUrl>https://github.com/systemslibrarian/PostQuantum.CryptographicBillOfMaterials</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Matches the LICENSE file, which is the legally operative text. `Authors` stays as the nuget.org
         account name; this is the copyright holder. -->
    <Copyright>Copyright (c) 2026 Paul Clark</Copyright>
  </PropertyGroup>

</Project>
