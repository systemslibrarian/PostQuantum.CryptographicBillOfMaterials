{
  // Example cbom.config.json. CLI flags override these; this overrides built-in defaults.
  // The loader supports // line comments and trailing commas.
  "profile": "general",
  "include": ["src/**"],
  "exclude": ["**/*.Tests/**", "**/Generated/**", "**/obj/**", "**/bin/**"],
  "failOn": "high",
  "formats": ["cyclonedx", "sarif", "summary"],

  "rules": {
    "CBOM0002": { "severityFloor": "critical" },

    // Per-algorithm tuning: tune one algorithm without disabling the whole rule.
    "CBOM0010": {
      "algorithms": {
        "MD5": { "severityFloor": "critical" }
      }
    },

    // Auditable waiver: disabling a rule is a recorded waiver. Under the 'audit' profile it
    // annotates instead of suppressing; an expired waiver re-activates the finding.
    "CBOM0050": {
      "enabled": false,
      "waiverJustification": "System.Random used only for non-security jitter; reviewed.",
      "waiverApprover": "security-team",
      "waiverExpiry": "2027-01-01"
    }
  },

  // Data sensitivity: long-lived confidentiality protected by quantum-vulnerable crypto is the top
  // harvest-now-decrypt-later priority. Match by path glob, or by namespace with an 'ns:' key.
  "dataSensitivityHints": {
    "src/Payments/**": { "dataLifetimeYears": 25, "dataClass": "financial" },
    "ns:Contoso.Billing.*": { "dataLifetimeYears": 30, "dataClass": "regulated" }
  }
}
